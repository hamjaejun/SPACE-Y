{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SPACE_Y_cooling_channel_template_grid.schema.json",
  "title": "SPACE Y preliminary rectangular cooling-channel template grid",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "source",
    "reference_width_candidates_m",
    "rib_thickness_candidates_m",
    "channel_height_candidates_m",
    "expected_template_count",
    "channel_count_policy",
    "design_approved"
  ],
  "properties": {
    "classification": {"const": "REFERENCE_GRID_NOT_APPROVED_DESIGN_RANGE"},
    "source": {"type": "string", "minLength": 1},
    "reference_width_candidates_m": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
    "rib_thickness_candidates_m": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
    "channel_height_candidates_m": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
    "expected_template_count": {"const": 80},
    "channel_count_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "integer_candidates", "requires_actual_throat_mean_channel_radius", "selection_performed"],
      "properties": {
        "formula": {"const": "N_ideal=2*pi*r_m_throat/(w_ref+b)"},
        "integer_candidates": {"const": "distinct floor and ceil of N_ideal"},
        "requires_actual_throat_mean_channel_radius": {"const": true},
        "selection_performed": {"const": false}
      }
    },
    "design_approved": {"const": false}
  }
}
