{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPACE Y exact-IPA property-source readiness record",
  "type": "object",
  "required": [
    "record_id", "purpose", "overall_status", "fluid_identity", "review_date",
    "candidates", "provenance", "capabilities", "physical_validation_v01_v12",
    "refinement_status_preserved"
  ],
  "properties": {
    "record_id": {"const": "SPACE-Y-IPA-PROPERTY-SOURCES-001"},
    "purpose": {"const": "ACTUAL_IPA_READINESS_ONLY_NO_ENGINE_RUN"},
    "overall_status": {"const": "INPUT_U"},
    "fluid_identity": {
      "type": "object",
      "required": ["chemical_name", "cas_number", "prohibited_substitutions"],
      "properties": {
        "chemical_name": {"const": "2-propanol"},
        "cas_number": {"const": "67-63-0"},
        "prohibited_substitutions": {
          "type": "array", "minItems": 1, "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "review_date": {"type": "string", "format": "date"},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "provenance": {
      "type": "object",
      "required": [
        "provider", "dataset_or_model", "version", "source_urls",
        "license_summary", "redistribution_scope", "enthalpy_reference"
      ],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "dataset_or_model": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "license_summary": {"type": ["string", "null"]},
        "redistribution_scope": {"type": "string", "minLength": 1},
        "enthalpy_reference": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "state_pt", "state_ph", "density", "viscosity", "cp", "conductivity",
        "saturation_at_temperature", "saturation_at_pressure", "phase_pt", "phase_ph"
      ],
      "properties": {
        "state_pt": {"$ref": "#/$defs/capability"},
        "state_ph": {"$ref": "#/$defs/capability"},
        "density": {"$ref": "#/$defs/capability"},
        "viscosity": {"$ref": "#/$defs/capability"},
        "cp": {"$ref": "#/$defs/capability"},
        "conductivity": {"$ref": "#/$defs/capability"},
        "saturation_at_temperature": {"$ref": "#/$defs/capability"},
        "saturation_at_pressure": {"$ref": "#/$defs/capability"},
        "phase_pt": {"$ref": "#/$defs/capability"},
        "phase_ph": {"$ref": "#/$defs/capability"}
      },
      "additionalProperties": false
    },
    "physical_validation_v01_v12": {"const": "NOT_RUN"},
    "refinement_status_preserved": {
      "type": "object",
      "required": ["asymptotic_regime", "four_n_is_truth", "richardson_extrapolation", "gci"],
      "properties": {
        "asymptotic_regime": {"const": "NOT_ESTABLISHED"},
        "four_n_is_truth": {"const": false},
        "richardson_extrapolation": {"const": "NOT_PERFORMED"},
        "gci": {"const": "NOT_PERFORMED"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableRange": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": [
        "status", "evidence", "valid_temperature_range_K",
        "valid_pressure_range_Pa_abs", "phase_scope"
      ],
      "properties": {
        "status": {"enum": ["AVAILABLE", "INPUT_U"]},
        "evidence": {"type": "string", "minLength": 1},
        "valid_temperature_range_K": {"$ref": "#/$defs/nullableRange"},
        "valid_pressure_range_Pa_abs": {"$ref": "#/$defs/nullableRange"},
        "phase_scope": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "provider", "dataset_or_model", "version", "exact_identity_confirmed",
        "available_scope", "unavailable_or_unconfirmed_scope", "valid_ranges",
        "uncertainty", "license_and_publication", "source_urls", "m0_status"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset_or_model": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "exact_identity_confirmed": {"type": "boolean"},
        "available_scope": {"type": "array", "items": {"type": "string"}},
        "unavailable_or_unconfirmed_scope": {"type": "array", "items": {"type": "string"}},
        "valid_ranges": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "string", "minLength": 1},
        "license_and_publication": {"type": "string", "minLength": 1},
        "source_urls": {
          "type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}
        },
        "m0_status": {"const": "INPUT_U"}
      },
      "additionalProperties": false
    }
  }
}
