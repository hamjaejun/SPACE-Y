{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPACE Y PDR candidate decision request",
  "type": "object",
  "required": [
    "schema_version", "purpose", "decision_id", "prepared_date",
    "requirements_version", "status_policy", "models", "sources",
    "assumptions", "global_missing_inputs", "candidates", "cad_handoff_request"
  ],
  "properties": {
    "schema_version": {"const": "SPACE_Y_PDR_DECISION_V1"},
    "purpose": {"enum": ["SYNTHETIC_DECISION_LOGIC_TEST", "PDR_CANDIDATE_ASSESSMENT"]},
    "decision_id": {"type": "string", "minLength": 1},
    "prepared_date": {"type": "string", "format": "date"},
    "requirements_version": {"type": "string", "minLength": 1},
    "status_policy": {
      "type": "object",
      "required": [
        "safety_is_hard_constraint", "allow_weighted_safety_tradeoff",
        "accepted_validation_levels"
      ],
      "properties": {
        "safety_is_hard_constraint": {"const": true},
        "allow_weighted_safety_tradeoff": {"const": false},
        "accepted_validation_levels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/validationLevel"}
        }
      },
      "additionalProperties": false
    },
    "models": {"type": "array", "items": {"$ref": "#/$defs/model"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "global_missing_inputs": {"type": "array", "items": {"type": "string"}},
    "candidates": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}
    },
    "cad_handoff_request": {"$ref": "#/$defs/cadHandoffRequest"}
  },
  "additionalProperties": false,
  "$defs": {
    "validationLevel": {
      "enum": [
        "NOT_VALIDATED", "SYNTHETIC_ARITHMETIC", "SOFTWARE_VERIFIED",
        "SOURCE_REVIEWED", "PHYSICAL_BENCHMARK", "TEST_VALIDATED"
      ]
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "type", "version", "locator", "license_scope", "status", "validation_level"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "locator": {"type": "string", "minLength": 1},
        "license_scope": {"type": "string", "minLength": 1},
        "status": {"enum": ["AVAILABLE", "INPUT_U", "RESTRICTED"]},
        "validation_level": {"$ref": "#/$defs/validationLevel"}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "name", "version", "scope", "equation_or_method", "source_ids", "status", "validation_level"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "equation_or_method": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["AVAILABLE", "INPUT_U", "OUTSIDE", "NUM_U", "MODEL_U"]},
        "validation_level": {"$ref": "#/$defs/validationLevel"}
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": ["id", "text", "status", "source_ids", "impact"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["CONFIRMED", "UNCONFIRMED", "REJECTED"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "impact": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "value", "unit", "status", "source_ids", "selection_reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "status": {"enum": ["DECIDED", "PROVISIONAL", "UNKNOWN"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "selection_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": [
        "id", "name", "mandatory", "status", "actual_value", "requirement",
        "unit", "equation_or_method", "model_ids", "source_ids", "assumption_ids",
        "validation_level", "uncertainty", "notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "INPUT_U", "OUTSIDE", "NUM_U", "MODEL_U"]},
        "actual_value": {"type": ["number", "string", "boolean", "null"]},
        "requirement": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "equation_or_method": {"type": "string", "minLength": 1},
        "model_ids": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "assumption_ids": {"type": "array", "items": {"type": "string"}},
        "validation_level": {"$ref": "#/$defs/validationLevel"},
        "uncertainty": {"type": ["string", "number", "null"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "constraintGroup": {
      "type": "object",
      "required": ["criteria", "unresolved_risks", "missing_required_inputs"],
      "properties": {
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
        "unresolved_risks": {"type": "array", "items": {"type": "string"}},
        "missing_required_inputs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "id", "label", "parameters", "performance_criteria",
        "performance_unresolved_risks", "performance_missing_inputs",
        "safety_assessments", "decision_notes"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
        "performance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
        "performance_unresolved_risks": {"type": "array", "items": {"type": "string"}},
        "performance_missing_inputs": {"type": "array", "items": {"type": "string"}},
        "safety_assessments": {
          "type": "object",
          "required": ["cooling", "supply", "structural", "combustion"],
          "properties": {
            "cooling": {"$ref": "#/$defs/constraintGroup"},
            "supply": {"$ref": "#/$defs/constraintGroup"},
            "structural": {"$ref": "#/$defs/constraintGroup"},
            "combustion": {"$ref": "#/$defs/constraintGroup"}
          },
          "additionalProperties": false
        },
        "decision_notes": {
          "type": "object",
          "required": ["advantages", "limitations", "additional_verification"],
          "properties": {
            "advantages": {"type": "array", "items": {"type": "string"}},
            "limitations": {"type": "array", "items": {"type": "string"}},
            "additional_verification": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cadRequirement": {
      "type": "object",
      "required": ["id", "name", "value", "unit", "status", "source_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "unit": {"type": ["string", "null"]},
        "status": {"enum": ["DECIDED", "PROVISIONAL", "UNKNOWN"]},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "cadHandoffRequest": {
      "type": "object",
      "required": [
        "provisional_baseline_candidate_id", "decided_requirements",
        "parameter_selection_reasons", "change_triggers",
        "pre_manufacture_and_test_risks"
      ],
      "properties": {
        "provisional_baseline_candidate_id": {"type": ["string", "null"]},
        "decided_requirements": {"type": "array", "items": {"$ref": "#/$defs/cadRequirement"}},
        "parameter_selection_reasons": {"type": "array", "items": {"type": "string"}},
        "change_triggers": {"type": "array", "items": {"type": "string"}},
        "pre_manufacture_and_test_risks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
